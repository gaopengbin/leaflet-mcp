{
  "name": "leaflet-mcp-bridge",
  "version": "0.1.0",
  "description": "Browser SDK — AI agent controls Leaflet map via WebSocket",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "leaflet": ">=1.9.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.0",
    "leaflet": "^1.9.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "leaflet",
    "mcp",
    "ai",
    "map",
    "websocket",
    "bridge"
  ],
  "license": "MIT"
}
